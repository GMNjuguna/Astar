# Public origin of this deployment. Used to build driver invitation links in
# app/api/manager/create-driver. Set this to your production URL on Vercel or any
# other hosted environment, e.g. https://astar-travels.vercel.app. Leaving it at
# localhost means every generated invite points at http://localhost:3000.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
